{
  "name": "omnira",
  "version": "1.0.0",
  "description": "Omnira — AI Engineering Studio & Product Design Partner web application built with Next.js App Router, TypeScript, and CSS Modules.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\" \"tests/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "omnira",
    "nextjs",
    "typescript",
    "ai-studio",
    "app-router"
  ],
  "author": "girishlade111",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
